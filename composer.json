{
    "name": "run-as-root/module-agentic-commerce-protocol",
    "description": "Magento 2 Extension for the Agentic Commerce Protocol - Enable ChatGPT purchases",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Run_As_Root",
            "email": "hello@run-as-root.sh",
            "homepage": "https://run-as-root.sh/"
        }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0",
        "magento/module-checkout": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1",
        "stripe/stripe-php": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "magento/magento-coding-standard": "^33",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "RunAsRoot\\AgenticCommerceProtocol\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RunAsRoot\\AgenticCommerceProtocol\\Test\\": "Test/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
