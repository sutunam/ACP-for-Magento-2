{
    "name": "sutunam/module-agentic-commerce-protocol",
    "description": "Magento 2 Extension for the Agentic Commerce Protocol - Enable ChatGPT purchases",
    "keywords": [
        "magento2",
        "commerce",
        "protocol"
    ],
    "homepage": "https://git.sutunam.com/magento2-extensions/module-agentic-commerce-protocol",
    "version": "1.0.0",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Run_As_Root",
            "email": "hello@run-as-root.sh",
            "homepage": "https://run-as-root.sh/"
        }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0",
        "magento/module-checkout": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1",
        "stripe/stripe-php": "^13.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3",
        "phpunit/phpunit": "^9",
        "bitexpert/phpstan-magento": "^0.32.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/extension-installer": "^1.4.3",
        "magento/magento-coding-standard": "^31.0",
        "magento/module-catalog": "^104.0",
        "magento/module-configurable-product": "^100.4"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Sutunam\\AgenticCommerceProtocol\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sutunam\\AgenticCommerceProtocol\\Test\\": "Test/"
        }
    },
    "repositories": {
        "magento": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        "sutunam": {
            "type": "composer",
            "url": "https://composer.sutunam.com/m2/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=-1",
        "phpcs": "vendor/bin/phpcs --ignore=*.xml --standard=Magento2 src/Model/Feed/ProductFeedGenerator.php",
        "post-install-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths vendor/magento/magento-coding-standard/,vendor/phpcompatibility/php-compatibility)"
        ],
        "post-update-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths vendor/magento/magento-coding-standard/,vendor/phpcompatibility/php-compatibility)"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "php-http/discovery": false,
            "magento/magento-composer-installer": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}