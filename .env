WARDEN_ENV_NAME=acp-magento2
WARDEN_ENV_TYPE=magento2
WARDEN_WEB_ROOT=/magento

TRAEFIK_DOMAIN=acp-magento2.test
TRAEFIK_SUBDOMAIN=app

WARDEN_DB=1
WARDEN_ELASTICSEARCH=0
WARDEN_OPENSEARCH=1
WARDEN_REDIS=1
WARDEN_RABBITMQ=0
WARDEN_VARNISH=0

WARDEN_ALLURE=0
WARDEN_SELENIUM=0
WARDEN_BLACKFIRE=0
WARDEN_SPLIT_SALES=0
WARDEN_SPLIT_CHECKOUT=0
WARDEN_TEST_DB=0
WARDEN_MAGEPACK=0

OPENSEARCH_VERSION=2.12
MARIADB_VERSION=10.6
NODE_VERSION=20
COMPOSER_VERSION=2
PHP_VERSION=8.2
REDIS_VERSION=7.2

WARDEN_SYNC_IGNORE=

COMPOSER_MEMORY_LIMIT=-1
