ELASTICSEARCH_VERSION=7.17
MARIADB_VERSION=10.6
NODE_VERSION=16
COMPOSER_VERSION=2
PHP_VERSION=8.2
REDIS_VERSION=7.0

WARDEN_SYNC_IGNORE=

COMPOSER_MEMORY_LIMIT=-1
